# Settings are read from the environment only. Copy to .env and load it with
# `uv run --env-file .env ...`, or export the variables.

# PostgreSQL server holding both databases
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Database names: the stocks database is the one rs-pipeline writes
STOCKS_DB_NAME=stocks
OPTION_DB_NAME=option_data

# Ticker that ETF relative strength is measured against (MKT in the demo), and the
# backtester's regime source
BENCHMARK_TICKER=SPY

# Where page 8 saves presets and the backtester caches its data
# PRESET_DIR=~/.config/stock_dashboard/presets
# CACHE_DIR=~/.cache/stock_dashboard
